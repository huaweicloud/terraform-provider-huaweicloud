{
  "provider_schemas": {
    "huaweicloud/huaweicloud": {
      "data_source_schemas": {
        "huaweicloud_gaussdb_top_sql_statements": {
          "block": {
            "attributes": {
              "db_name": {
                "type": "string",
                "optional": true
              },
              "end_time": {
                "type": "number",
                "required": true
              },
              "end_time_utc": {
                "type": "string",
                "optional": true
              },
              "id": {
                "type": "string",
                "computed": true
              },
              "instance_id": {
                "type": "string",
                "required": true
              },
              "node_ids": {
                "type": [
                  "list",
                  "string"
                ],
                "required": true
              },
              "region": {
                "type": "string",
                "computed": true
              },
              "sql_id": {
                "type": "string",
                "optional": true
              },
              "sql_text": {
                "type": "string",
                "optional": true
              },
              "start_time": {
                "type": "number",
                "required": true
              },
              "start_time_utc": {
                "type": "string",
                "optional": true
              },
              "support_system": {
                "type": "bool",
                "optional": true,
                "default": false
              },
              "top_sql_infos": {
                "type": [
                  "list",
                  [
                    "object",
                    {
                      "avg_elapse_time": "string",
                      "calls": "string",
                      "calls_percent": "string",
                      "cpu_percent": "string",
                      "cpu_time": "string",
                      "db_name": "string",
                      "io_percent": "string",
                      "io_time": "string",
                      "max_elapse_time": "string",
                      "min_elapse_time": "string",
                      "node_id": "string",
                      "node_name": "string",
                      "returned_rows": "string",
                      "sql_hit_ratio": "string",
                      "sql_id": "string",
                      "sql_text": "string",
                      "total_elapse_time": "string",
                      "tuple_read": "string",
                      "user_name": "string"
                    }
                  ]
                ],
                "computed": true
              },
              "user_name": {
                "type": "string",
                "optional": true
              }
            },
            "block_types": {
              "multi_queries": {
                "block": {
                  "attributes": {
                    "condition": {
                      "type": "string",
                      "required": true
                    },
                    "is_fuzzy": {
                      "type": "string",
                      "optional": true
                    },
                    "name": {
                      "type": "string",
                      "required": true
                    },
                    "values": {
                      "type": [
                        "list",
                        "string"
                      ],
                      "required": true
                    }
                  }
                },
                "nesting_mode": "list"
              }
            }
          },
          "product": {
            "short": "GaussDB",
            "name": "GaussDB",
            "catalog": "Databases",
            "name_cn": "云数据库 GaussDB",
            "catalog_cn": "数据库"
          }
        }
      }
    }
  }
}
