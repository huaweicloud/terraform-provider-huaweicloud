{
  "provider_schemas": {
    "huaweicloud/huaweicloud": {
      "data_source_schemas": {
        "huaweicloud_drs_replay_records": {
          "block": {
            "attributes": {
              "end_time": {
                "type": "number",
                "required": true
              },
              "id": {
                "type": "string",
                "computed": true
              },
              "job_id": {
                "type": "string",
                "required": true
              },
              "region": {
                "type": "string",
                "computed": true
              },
              "sql_records": {
                "type": [
                  "list",
                  [
                    "object",
                    {
                      "abnormal_sql": "number",
                      "execute_time": "number",
                      "finished_sql": "number",
                      "slow_sql": "number",
                      "total_sql": "number"
                    }
                  ]
                ],
                "computed": true
              },
              "start_time": {
                "type": "number",
                "required": true
              },
              "total_count": {
                "type": "number",
                "computed": true
              }
            }
          },
          "product": {
            "short": "DRS",
            "name": "Data Replication Service",
            "catalog": "Databases",
            "name_cn": "数据复制服务",
            "catalog_cn": "数据库"
          }
        }
      }
    }
  }
}
