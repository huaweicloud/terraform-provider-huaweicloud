                      "name": "string",
                      "provider_id": "string",
                      "tags": [
                        "map",
                        "string"
                      ],
                      "thumbprints": [
                        "list",
                        "string"
                      ],
                      "url": "string",
                      "urn": "string"
                    }
                  ]
                ],
