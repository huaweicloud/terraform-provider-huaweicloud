{
  "provider_schemas": {
    "huaweicloud/huaweicloud": {
      "data_source_schemas": {
        "huaweicloud_dcs_replications": {
          "block": {
            "attributes": {
              "group_id": {
                "type": "string",
                "description": "Specifies the ID of the shard.",
                "required": true
              },
              "id": {
                "type": "string",
                "computed": true
              },
              "instance_id": {
                "type": "string",
                "description": "Specifies the ID of the DCS instance.",
                "required": true
              },
              "region": {
                "type": "string",
